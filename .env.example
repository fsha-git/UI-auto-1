# 复制成 .env 后 docker compose 会自动读取：cp .env.example .env
#
# Linux 宿主机需要这两个，否则容器以 root 跑，reports/、test-results/、.auth/
# 里会留下 root 属主的文件，宿主机上删不掉也读不了。
# macOS / Windows 的 Docker Desktop 自己处理绑定挂载属主，留空即可。
#
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" > .env
HOST_UID=
HOST_GID=

# 传给容器里 pytest 的额外参数。带引号的参数会被正确保留成一个词，例如：
#   PYTEST_ARGS=-m "not perf"
PYTEST_ARGS=

# perf/run_perf.sh 认的环境变量（都有默认值，一般不用改）。
# PERF_PORT=8000
# PERF_ACCOUNTS=perf/accounts.csv
# PERF_HISTORY=reports/jmeter/history.jsonl
# PERF_MAX_REGRESSION_PCT=25
